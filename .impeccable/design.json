  "narrative": {
    "northStar": "The Operator's Briefing",
    "overview": "The site reads like a capable operations manager walking an owner through what got done: plain claims, real numbers, a clear next step. Confidence comes from structure and proof, not decoration. Headlines are heavy and tightly tracked, body copy is roomy and easy to read, and every page alternates calm white reading sections with deep navy and MVP blue bands that mark the moments that matter.\n\nThe system is calm and trustworthy rather than loud. Shadows are soft and blue-tinted, corners are gently rounded, and hover states move a single pixel. The one human touch is the handwritten Caveat note, used sparingly, like a manager's margin comment on a report.\n\nEverything is assembled from a fixed library of 25 approved section types (`shared/library/SECTIONS.md`, live reference in `shared/library/components.html`). New visual ideas enter the library first, with approval, and only then appear on a page.",
    "keyCharacteristics": [
      "White, navy and MVP blue only, with pale blue as a quiet accent.",
      "Heavy Manrope headlines with tight negative tracking; generous 1.6 body leading.",
      "High-contrast bands set the page rhythm: never more than two light sections in a row.",
      "Soft blue-tinted shadows and 8px or 12px corners; nothing sharp, nothing bubbly.",
      "Proof-first: stat tiles, checklists and comparison tables carry the argument.",
      "One optional handwritten note per moment, never as body text."
    ],
    "rules": [
      {
        "name": "The Variables Only Rule",
        "body": "Every color comes from a `:root` variable in `shared/styles.css`. A typed-in hex value in a page or section style is a bug.",
        "section": "colors"
      },
      {
        "name": "The No New Colors Rule",
        "body": "Navy, MVP blue, white and light blue are the whole palette. Danger red exists only for cross marks.",
        "section": "colors"
      },
      {
        "name": "The Pale Is an Accent Rule",
        "body": "Pale blue backgrounds sit between white sections for relief. They are never the default page background.",
        "section": "colors"
      },
      {
        "name": "The 16/14/12 Rule",
        "body": "Body text is at least 16px, secondary text at least 14px, and only labels, eyebrows and fine print go down to 12px. Nothing smaller, ever.",
        "section": "typography"
      },
      {
        "name": "The One Voice, One Note Rule",
        "body": "Caveat is never used for body copy, headings or buttons. One handwritten note per section at most.",
        "section": "typography"
      },
      {
        "name": "The Two Light Sections Rule",
        "body": "Never more than two light sections (white, pale blue, soft) in a row.",
        "section": "layout"
      },
      {
        "name": "The Three Breaks Rule",
        "body": "Every long landing page has at least three high-contrast breaks (navy, MVP blue, dark split, photo-led or dark band) before the final CTA. The hero does not count.",
        "section": "layout"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "Shadows are tinted navy or blue, never pure black, and never sharper than the card shadow at rest.",
        "section": "elevation"
      },
      {
        "name": "The Flat Bands Rule",
        "body": "On navy and MVP blue sections, prefer white type, simple rules and icons over white cards. Depth on dark comes from contrast, not shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do build every page from the 25 library section types, copying markup and class names from `shared/library/components.html`.",
      "Do take every color from the `:root` variables in `shared/styles.css`.",
      "Do keep body text at 16px or more, secondary at 14px or more, and only labels at 12px.",
      "Do alternate light and dark: at most two light sections in a row, and at least three high-contrast breaks before the final CTA.",
      "Do use solid Heroicons as inline SVG for icons, in MVP Blue on light and white on dark.",
      "Do use the logo image in the header and footer.",
      "Do end every page with the CTA band."
    ],
    "donts": [
      "Don't type a hex color into a page or section style, or introduce any color outside navy, MVP blue, white and light blue.",
      "Don't add new CSS unless a new section type has been approved and added to the library first.",
      "Don't recreate the logo as text.",
      "Don't use pale blue as the default background.",
      "Don't put white cards on navy or MVP blue bands unless they are genuinely needed.",
      "Don't turn every list or idea into a card; consider typography, a rail, a split, a list or a pull statement first.",
      "Don't use numbered steps (Step 1, 01 / 02) in the composition patterns 19 to 25.",
      "Don't use photos of handshakes, headsets or posed sales teams; use candid conversation between professionals.",
      "Don't use Caveat for anything but an occasional handwritten note.",
      "Don't use em dashes in any text."
    ]
  }
}
